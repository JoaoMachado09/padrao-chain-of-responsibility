@startuml diagrama-classes
title Chain of Responsibility - Aprovação de Solicitações de RH
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
}
hide empty members
class Solicitacao {
  - colaborador : String
  - tipoSolicitacao : TipoSolicitacao
  + Solicitacao(colaborador : String, tipoSolicitacao : TipoSolicitacao)
  + getColaborador() : String
  + getTipoSolicitacao() : TipoSolicitacao
}
interface TipoSolicitacao
class TipoSolicitacaoAtestado <<singleton>> {
  + {static} getTipoSolicitacaoAtestado() : TipoSolicitacaoAtestado
}
class TipoSolicitacaoFerias <<singleton>> {
  + {static} getTipoSolicitacaoFerias() : TipoSolicitacaoFerias
}
class TipoSolicitacaoPromocao <<singleton>> {
  + {static} getTipoSolicitacaoPromocao() : TipoSolicitacaoPromocao
}
class TipoSolicitacaoContratacao <<singleton>> {
  + {static} getTipoSolicitacaoContratacao() : TipoSolicitacaoContratacao
}
class TipoSolicitacaoReajusteGeral <<singleton>> {
  + {static} getTipoSolicitacaoReajusteGeral() : TipoSolicitacaoReajusteGeral
}
abstract class Aprovador {
  # listaSolicitacoes : ArrayList<TipoSolicitacao>
  - aprovadorSuperior : Aprovador
  + getAprovadorSuperior() : Aprovador
  + setAprovadorSuperior(aprovadorSuperior : Aprovador)
  + {abstract} getDescricaoCargo() : String
  + aprovarSolicitacao(solicitacao : Solicitacao) : String
}
class AprovadorSupervisor {
  + getDescricaoCargo() : String
}
class AprovadorGerente {
  + getDescricaoCargo() : String
}
class AprovadorDiretor {
  + getDescricaoCargo() : String
}
class AprovadorPresidente {
  + getDescricaoCargo() : String
}

Aprovador o--> "0..1" Aprovador : aprovadorSuperior
Aprovador <|-- AprovadorSupervisor
Aprovador <|-- AprovadorGerente
Aprovador <|-- AprovadorDiretor
Aprovador <|-- AprovadorPresidente
Aprovador ..> Solicitacao
Aprovador --> "*" TipoSolicitacao
Solicitacao --> TipoSolicitacao
TipoSolicitacao <|.. TipoSolicitacaoAtestado
TipoSolicitacao <|.. TipoSolicitacaoFerias
TipoSolicitacao <|.. TipoSolicitacaoPromocao
TipoSolicitacao <|.. TipoSolicitacaoContratacao
TipoSolicitacao <|.. TipoSolicitacaoReajusteGeral
@enduml
